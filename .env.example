# Copy the keys you need into your real .env (which is gitignored).
# Do NOT commit real secrets.

# ===== API testing (Multi tenant MCD Alchemy) =====
# --- Azure AD (client credentials) ---
AAD_TENANT_ID=00000000-0000-0000-0000-000000000000
AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AAD_CLIENT_SECRET=your-client-secret-here
AAD_SCOPE=https://DwsUnisysShared.onmicrosoft.com/<app-id>/.default

# --- SEA middleware API ---
API_BASE_URL=https://unisys-sea-shared-dev.eastus.cloudapp.azure.com
API_TENANT_ID=00000000-0000-0000-0000-000000000000
API_CALLER_CLIENT=epa
API_TIMEOUT=30000

# --- Test data ---
TEST_CASE_NUMBER=RC0004977
TEST_CASE_NUMBER_NOT_FOUND=RC9999999

# ===== Mobile/web vars (values live only in your local .env) =====
